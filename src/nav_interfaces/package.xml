<?xml version="1.0"?>
<package format="3">
  <name>nav_interfaces</name>
  <version>0.1.0</version>
  <description>Service definitions (shared ROS 2 interfaces).</description>
  <maintainer email="duyf23@mail2.sysu.edu.cn">user</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <build_depend>rosidl_default_generators</build_depend>
